# The web UI asks you to create an account (username + password) on first
# visit. Until then the UI/API is open — create one when exposing the port.

# Optional: change the web UI port (default 8999). In Docker this is the
# host-side port; the container always listens on 8999.
# TABYBOT_PORT=8999

# Optional: host interface the Docker port mapping binds to (default
# 0.0.0.0 = all interfaces, reachable from the LAN). Set 127.0.0.1 for
# this machine only — combine external access with an account.
# TABYBOT_BIND=0.0.0.0

# Optional: address the app listens on in local (non-Docker) mode
# (default 0.0.0.0). Ignored in Docker.
# TABYBOT_HOST=0.0.0.0
